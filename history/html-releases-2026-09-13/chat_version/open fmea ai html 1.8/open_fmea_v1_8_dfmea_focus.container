    {
      "id": "CASE-DFMEA-BASELINE-001",
      "title": "DFMEA view must remain aligned with controlled mockup while functionality evolves",
      "domain": "Open FMEA Software / DFMEA module",
      "failureMode": "Feature additions alter DFMEA layout or remove expected mockup widgets/functions.",
      "cause": "No page-specific controlled baseline gate during implementation.",
      "detection": "User comparison against supplied DFMEA mockup.",
      "methods": [
        "Validation Test",
        "Change Impact",
        "Regression Analysis"
      ],
      "action": "Lock DFMEA mockup as validation baseline and implement alternate DFMEA functions over the same shared records.",
      "result": "DFMEA development now requires visual + functional + responsive regression validation.",
      "lessons": [
        "Do not trade mockup parity for new feature work.",
        "Tabs are alternate views, not duplicate data stores.",
        "Every DFMEA chart must derive from current source records."
      ],
      "sources": [
        "Supplied DFMEA mockup",
        "VAL-GUI-DFMEA-001"
      ],
