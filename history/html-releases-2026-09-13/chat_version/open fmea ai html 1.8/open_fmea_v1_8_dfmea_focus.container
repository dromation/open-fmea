  "softwareCharacteristics": [
    {
      "id": "SWC-001",
      "name": "Responsive browser layout",
      "category": "Usability",
      "requirement": "All widgets adapt to browser size and resize without loss of function.",
      "target": "No clipped primary controls; local scroll only where necessary.",
      "verification": "Resize test 320–2560 px",
      "status": "Active",
      "criticality": "High",
      "source": "Open FMEA development"
    },
    {
      "id": "SWC-002",
      "name": "Container backward compatibility",
      "category": "Reliability",
      "requirement": "Older local snapshots shall not break rendering after schema upgrades.",
      "target": "Graceful migration or fallback to embedded defaults.",
      "verification": "Migration regression test",
      "status": "Active",
      "criticality": "Critical",
      "source": "Open FMEA development"
    },
    {
      "id": "SWC-003",
      "name": "Risk Matrix drill-down",
      "category": "Functional",
      "requirement": "Matrix cells shall display risk counts and open risks belonging to the selected S/O cell.",
      "target": "Count equals filtered DFMEA/PFMEA records.",
      "verification": "Matrix count/filter consistency test",
      "status": "Active",
      "criticality": "High",
      "source": "Open FMEA development"
    },
    {
      "id": "SWC-004",
      "name": "Time-based risk trajectory",
      "category": "Functional",
      "requirement": "Risk trajectory shall support lifecycle and calendar time with selectable ranges.",
      "target": "Lifecycle, day/week/month range and From/To filtering.",
      "verification": "Trajectory range test",
      "status": "Active",
      "criticality": "High",
      "source": "Open FMEA development"
    },
    {
      "id": "SWC-005",
      "name": "Traceable AI recommendations",
      "category": "AI / Governance",
      "requirement": "Every AI recommendation shall identify source records and be user-confirmed before authoritative changes.",
      "target": "FACT/CALCULATION/INFERENCE/RECOMMENDATION + source IDs.",
      "verification": "AI provenance test",
      "status": "Active",
      "criticality": "Critical",
      "source": "Open-EQMS architecture"
    },
    {
      "id": "SWC-006",
      "name": "Offline single-file runtime",
      "category": "Deployment",
      "requirement": "Core FMEA functionality shall remain usable without an AI service or internet connection.",
      "target": "HTML + container works locally.",
      "verification": "Offline browser test",
      "status": "Active",
      "criticality": "High",
      "source": "Open-EQMS architecture"
    },
    {
      "id": "SWC-007",
      "name": "Change Impact temporal analysis",
      "category": "Functional",
      "requirement": "Change Impact shall provide legends and day/week time views.",
      "target": "Legend values and selectable temporal buckets.",
      "verification": "Change Impact visual/data test",
      "status": "Active",
      "criticality": "Medium",
      "source": "Open FMEA development"
    },
    {
      "id": "SWC-008",
      "name": "Cross-module object identity",
      "category": "Data Integrity",
      "requirement": "A single characteristic/failure/cause/control object shall be reused across all views.",
      "target": "No duplicate source-of-truth objects.",
      "verification": "Referential integrity diagnostics",
      "status": "Active",
      "criticality": "Critical",
      "source": "Open-EQMS architecture"
    }
  ],
  "requirementGaps": [
