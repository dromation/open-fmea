  "learningCases": [
    {
      "id": "CASE-001",
      "title": "Blank GUI after schema extension",
      "domain": "Software FMEA",
      "failureMode": "Only static shell renders; dashboard/navigation content missing.",
      "cause": "Older browser snapshot overwrote newer embedded data structure; required arrays were absent.",
      "detection": "Browser showed header/sidebar shell and empty workspace.",
      "methods": [
        "5WHY",
        "Change Impact",
        "Migration Test"
      ],
      "action": "Schema merge/migration with default fallback and render error boundary.",
      "result": "Newer versions tolerate older snapshots and surface diagnostics instead of white screen.",
      "lessons": [
        "Never replace new schema wholesale with old local snapshot.",
        "Validate and migrate before render.",
        "Keep reset/recovery path."
      ],
      "sources": [
        "Open FMEA development history"
      ],
      "approved": true,
      "qualityScore": 0.98
    },
    {
      "id": "CASE-002",
      "title": "Risk Matrix lacked traceable contents",
      "domain": "Software FMEA",
      "failureMode": "Risk matrix visualized risk zones but did not show how many risks were in a cell or which risks they were.",
      "cause": "Mockup-focused rendering without data-driven bucket aggregation.",
      "detection": "User review of Risk Matrix.",
      "methods": [
        "5WHY",
        "Data Traceability"
      ],
      "action": "Aggregate DFMEA/PFMEA by S/O, show count badge, drill down to filtered records.",
      "result": "Matrix is now a live view of FMEA data rather than a decorative heatmap.",
      "lessons": [
        "Every visualization must drill down to source objects.",
        "Count widgets must be computed from live data."
      ],
      "sources": [
        "Open FMEA development history"
      ],
      "approved": true,
      "qualityScore": 0.97
    },
    {
      "id": "CASE-003",
      "title": "Risk trajectory had no selectable time basis",
      "domain": "Software FMEA",
      "failureMode": "Trajectory showed lifecycle progression but could not answer time-window questions.",
      "cause": "Lifecycle mockup implemented without calendar query controls.",
      "detection": "User requested days/weeks and selectable interval.",
      "methods": [
        "Requirement Gap",
        "Change Impact"
      ],
      "action": "Add lifecycle/calendar mode, period selection and From/To dates.",
      "result": "Trajectory can support both development phase and calendar analysis.",
      "lessons": [
        "Every trend needs an explicit time basis.",
        "Timeline controls belong to the data query, not only to chart styling."
      ],
      "sources": [
        "Open FMEA development history"
      ],
      "approved": true,
      "qualityScore": 0.96
    },
    {
      "id": "CASE-004",
      "title": "Fixed-size widgets failed browser resizing",
      "domain": "Software FMEA",
      "failureMode": "Widgets/matrices/tables do not fit when the browser is resized.",
      "cause": "Fixed grid widths and minimum sizes inherited from static mockups.",
      "detection": "Manual resize review.",
      "methods": [
        "6M",
        "Usability Review"
      ],
      "action": "Responsive auto-fit grids, minmax(0,1fr), local overflow for dense data, breakpoints.",
      "result": "Primary UI adapts; dense tables/matrices use local scrolling where needed.",
      "lessons": [
        "Mockup pixels are reference, not runtime constraints.",
        "Responsive behavior is a software characteristic and testable requirement."
      ],
      "sources": [
        "Open FMEA development history"
      ],
      "approved": true,
      "qualityScore": 0.95
    },
    {
      "id": "CASE-005",
      "title": "Change Impact charts lacked explanatory legends/time granularity",
      "domain": "Software FMEA",
      "failureMode": "Charts were visually present but decision context was incomplete.",
      "cause": "Dashboard chart decoration implemented before explicit interpretation requirements.",
      "detection": "User review.",
      "methods": [
        "Requirement Gap",
        "5WHY"
      ],
      "action": "Add legend with values/percentages and day/week temporal buckets.",
      "result": "Change Impact supports interpretation and temporal investigation.",
      "lessons": [
        "A chart without legend/time basis can be misleading.",
        "Dashboard acceptance criteria must include decision usability."
      ],
      "sources": [
        "Open FMEA development history"
      ],
      "approved": true,
      "qualityScore": 0.94
    },
    {
      "id": "CASE-006",
      "title": "Mockup pages existed without complete functional behavior",
      "domain": "Software FMEA",
      "failureMode": "Buttons/widgets look complete but actions do not modify or query shared data.",
      "cause": "Presentation layer developed ahead of universal action/transaction wiring.",
      "detection": "Feature-by-feature functional review.",
      "methods": [
        "8D",
        "5WHY",
        "Systemic corrective action"
      ],
      "action": "Introduce shared CRUD, filters, transaction log, autosave, import/export and cross-module object links.",
      "result": "Open FMEA moves from dashboard prototype toward functional engineering application.",
      "lessons": [
        "No dead controls.",
        "All meaningful UI actions should map to commands/transactions.",
        "Use shared engines instead of page-specific scripts."
      ],
      "sources": [
        "Open FMEA development history"
      ],
      "approved": true,
      "qualityScore": 0.99
    },
    {
      "id": "CASE-HIST-001",
      "title": "GUI shell visible but workspace blank",
      "domain": "Open FMEA Software / GUI",
      "failureMode": "Static shell renders while main application content fails to render.",
      "cause": "Version/schema/runtime integration regression; older state may override newer expected data shape.",
      "detection": "Observed functional regression in historical Open FMEA builds.",
      "methods": [
        "Validation Test",
        "Change Impact",
        "Regression Analysis"
      ],
      "action": "Add migration/default merge, diagnostics and render error boundary.",
      "result": "Requires/feeds regression validation",
      "lessons": [
        "Mockup is a controlled validation baseline.",
        "GUI regression is a software failure mode.",
        "Do not accept feature work without regression validation."
      ],
      "sources": [
        "open_fmea_v1_1.html",
        "open_fmea_v1_1_fixed.html"
      ],
      "approved": true,
      "qualityScore": 0.99
    },
    {
      "id": "CASE-HIST-002",
      "title": "Feature-complete appearance without feature-complete behavior",
      "domain": "Open FMEA Software / GUI",
      "failureMode": "Widgets/buttons are visible but do not execute the expected data operation.",
      "cause": "Presentation implementation progressed faster than shared command/data-flow wiring.",
      "detection": "Functional review across v1.2/v1.3 evolution.",
      "methods": [
        "Validation Test",
        "Change Impact",
        "Regression Analysis"
      ],
      "action": "Shared CRUD/import/export/history/transaction runtime.",
      "result": "Requires/feeds regression validation",
      "lessons": [
        "Mockup is a controlled validation baseline.",
        "GUI regression is a software failure mode.",
        "Do not accept feature work without regression validation."
      ],
      "sources": [
