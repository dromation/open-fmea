  "validationTests": [
    {
      "id": "VAL-GUI-HOME-001",
      "page": "Home",
      "baseline": "Home mockup",
      "validationType": "Mockup parity + functional smoke",
      "acceptance": [
        "Left navigation, topbar, KPI cards, risk overview, validation trajectory, high-risk panel and engineering context remain visible in intended hierarchy.",
        "Widgets resize with browser width without overlapping or disappearing.",
        "Primary controls remain clickable after browser resize.",
        "All displayed KPI values are computed or traceable to container records."
      ]
    },
    {
      "id": "VAL-GUI-PROJ-001",
      "page": "FMEA Projects",
      "baseline": "FMEA Projects mockup",
      "validationType": "Mockup parity + CRUD",
      "acceptance": [
        "Project KPI cards, project table/list, type/status/progress/owner/updated/actions match mockup information architecture.",
        "New/Open/Edit/Duplicate/Delete/Search/Filter actions work.",
        "Project selection changes active project context without corrupting other pages.",
        "Responsive layout preserves all project actions."
      ]
    },
    {
      "id": "VAL-GUI-TEAM-001",
      "page": "FMEA Team",
      "baseline": "FMEA Team mockup",
      "validationType": "Mockup parity + authority workflow",
      "acceptance": [
        "Team KPIs, members, roles and role description panel are represented.",
        "Add/Edit/Assign/Delegate/Remove are functional and audited.",
        "Role/authority changes propagate to team context and transaction log.",
        "Responsive layout does not hide member actions."
      ]
    },
    {
      "id": "VAL-GUI-SPP-001",
      "page": "System / Product / Process",
      "baseline": "System / Product / Process mockup",
      "validationType": "Hierarchy + linkage",
      "acceptance": [
        "Systems/Products/Processes are navigable as a hierarchy.",
        "Selected item shows details and linked characteristics/FMEA context.",
        "Create/Edit/Duplicate/Delete preserve parent-child integrity.",
        "Broken links are detected instead of silently ignored."
      ]
    },
    {
      "id": "VAL-GUI-CHAR-001",
      "page": "System Characteristics Base",
      "baseline": "System Characteristics Base mockup",
      "validationType": "Mockup parity + characteristic traceability",
      "acceptance": [
        "Characteristic KPI cards, tabs/filters/table/detail panel and bottom summaries follow mockup hierarchy.",
        "New/Edit/Duplicate/Delete/Filter/Search work.",
        "Characteristic links resolve to System/Product/Process and FMEA objects.",
        "Critical/Special/Key classifications remain visually and semantically distinct."
      ]
    },
    {
      "id": "VAL-GUI-RISK-001",
      "page": "Risk Matrix",
      "baseline": "Risk Matrix mockup + later corrections",
      "validationType": "Data-driven visual validation",
      "acceptance": [
        "Matrix fills available browser width at normal widths and uses local scroll only at narrow widths.",
        "Each S/O cell shows the number of risks in that bucket.",
        "Clicking a cell/count lists only risks belonging to that S/O combination.",
        "Counts equal live DFMEA/PFMEA source records.",
        "Changing S/O/D updates RPN and re-buckets the risk."
      ]
    },
    {
      "id": "VAL-GUI-TRAJ-001",
      "page": "Risk Trajectory",
      "baseline": "Risk Trajectory mockup + time-selection correction",
      "validationType": "Temporal analysis",
      "acceptance": [
        "Lifecycle and calendar time bases are selectable.",
        "User can select day/week/month/range or From/To where supported.",
        "Trajectory points link back to source risk.",
        "Time filtering does not alter authoritative source records."
      ]
    },
    {
      "id": "VAL-GUI-CHANGE-001",
      "page": "Change Impact",
      "baseline": "Change Impact mockup + legend/time corrections",
      "validationType": "Chart interpretation + temporal change analysis",
      "acceptance": [
        "Both donut/pie charts have legends with values and percentages.",
        "Changes Over Time provides day/week view, a selectable range and a legend.",
        "Chart counts equal change records in the selected period.",
        "Change records link affected FMEA items and validation evidence."
      ]
    },
    {
      "id": "VAL-GUI-DFMEA-001",
      "page": "DFMEA",
      "baseline": "Supplied DFMEA mockup (current controlled baseline)",
      "validationType": "FMEA workflow",
      "acceptance": [
        "Header, KPI cards, toolbar, DFMEA tabs, filters, main DFMEA table, right item detail panel, RPN summary, RPN trend, Top 5 current RPN, Actions by Status and DFMEA Progress follow the supplied mockup information hierarchy.",
        "New DFMEA Item, Import, Export, Reports, View Options, Filters, row selection and detail editing are functional.",
        "DFMEA table exposes Element/Part, Function, Failure Mode, Effects, Severity, Causes, Occurrence, Prevention/Detection controls, RPN, Actions and Status.",
        "S/O/D updates recalculate risk and create an auditable transaction.",
        "All charts and counters are derived from live DFMEA/action data rather than fixed demo values.",
        "Structure Tree, Interface Matrix, Parameter Diagram, RPN Overview and Action Tracker are functional alternate views over the same DFMEA objects.",
        "Browser resize preserves the mockup hierarchy; dense DFMEA table uses local horizontal scrolling without breaking the page.",
        "Any later GUI drift from this controlled baseline creates a validation finding / software failure mode."
      ]
    },
    {
      "id": "VAL-GUI-PFMEA-001",
      "page": "PFMEA",
      "baseline": "PFMEA mockup",
      "validationType": "FMEA workflow",
      "acceptance": [
        "PFMEA process-step/function/failure/effect/cause/control structure follows mockup.",
        "Risk changes propagate to matrix, trajectory and action views.",
        "Process control and Poka-Yoke links are resolvable.",
        "Changes are audited."
      ]
    },
    {
      "id": "VAL-GUI-PS-001",
      "page": "Problem Solving",
      "baseline": "Ishikawa / WHY / 8D / Poka-Yoke design",
      "validationType": "Method workflow",
      "acceptance": [
        "Ishikawa supports 5M/6M categories and links causes.",
        "3WHY/5WHY chain is editable and traceable.",
        "8D D0-D8 data persists and links containment/root cause/action/validation.",
        "Poka-Yoke links prevention/detection/reaction/evidence.",
        "Method outputs can become learning cases only after user confirmation."
      ]
    },
    {
      "id": "VAL-GUI-RESP-001",
      "page": "All pages",
      "baseline": "All supplied mockups",
      "validationType": "Responsive regression",
      "acceptance": [
        "No primary widget disappears because of viewport resizing.",
        "No global horizontal overflow caused by a single widget.",
        "Dense tables/graphs use local overflow where necessary.",
        "Layout remains usable across 320, 480, 768, 1024, 1366, 1920 and 2560 px widths."
      ]
    }
  ],
  "dataFlowPipeline": {
    "schema": "open-fmea-pipeline/1.0",
    "name": "Open FMEA Data Flow & Validation Pipeline",
    "principles": {
      "authoritative_state": "open_fmea.container",
      "ui_baseline": "mockup validation registry",
      "learning_corpus": "open_fmea_ai_knowledge.jsonl",
      "human_context": [
        ".md",
        ".txt"
      ],
      "relational_companion": "SQLite",
      "rule": "AI suggestions and validation findings never directly overwrite authoritative FMEA data."
    },
    "flows": [
      {
        "id": "FLOW-REQ-FMEA",
        "name": "Requirement to FMEA",
        "stages": [
          "Source Requirement",
          "Requirement Gap Detection",
          "Candidate Failure Mode",
          "Human Review",
          "Approved FMEA Object",
          "Controls & Actions",
          "Validation",
          "Residual Risk",
          "Learning Case"
        ],
        "failure_conditions": [
          "untraceable source",
          "automatic approval",
          "duplicate object",
          "broken link"
        ]
      },
      {
        "id": "FLOW-MOCKUP-VALIDATION",
        "name": "Mockup to validation to change",
        "stages": [
          "Mockup Baseline",
          "Rendered Page",
          "Visual/Functional Validation",
          "Failure Finding",
          "Change Impact",
          "Corrective Change",
          "Regression Validation",
          "Approved Learning Case"
        ],
        "failure_conditions": [
          "GUI drift",
          "missing widget",
          "dead control",
          "wrong layout",
          "wrong computed value",
          "broken responsiveness",
          "missing data linkage"
        ]
      },
      {
        "id": "FLOW-CHANGE-RISK",
        "name": "Change impact propagation",
        "stages": [
          "Change Record",
          "Affected Objects",
          "DFMEA/PFMEA Re-evaluation",
          "Controls/Actions",
          "Validation Evidence",
          "Risk Matrix",
          "Risk Trajectory",
          "Closure"
        ],
        "failure_conditions": [
          "change not propagated",
          "stale risk",
          "missing validation",
          "unresolved affected object"
        ]
      },
      {
        "id": "FLOW-PROBLEM-SOLVING",
        "name": "Problem-solving learning loop",
        "stages": [
          "Failure/Issue",
          "Ishikawa 5M/6M",
          "3WHY/5WHY",
          "8D",
          "Poka-Yoke/Controls",
          "Action",
          "Evidence",
          "Effectiveness Review",
          "Learning Case"
        ],
        "failure_conditions": [
          "root cause without evidence",
          "action without verification",
          "lesson learned without provenance"
        ]
      },
      {
        "id": "FLOW-AI-DECISION",
        "name": "AI-assisted decision flow",
        "stages": [
          "User Question / Current Object",
          "Retrieve Authoritative Data",
          "Retrieve Mockup/Validation History",
          "Retrieve Similar Learning Cases",
          "Apply Deterministic Calculators/Rules",
          "Rank Recommendations",
          "Show Provenance",
          "User Accept/Modify/Reject",
          "Store Feedback"
        ],
        "failure_conditions": [
          "AI invents authoritative state",
          "missing provenance",
          "feedback not recorded",
          "model overwrites business rule"
        ]
      }
    ],
    "artifacts": [
      {
        "name": "open_fmea.html",
        "role": "runtime/UI"
      },
      {
        "name": "open_fmea.container",
        "role": "portable authoritative application state"
      },
      {
        "name": "open_fmea_ai_knowledge.jsonl",
        "role": "AI/case learning corpus"
      },
      {
        "name": "open_fmea_validation_tests.jsonl",
        "role": "mockup + functional validation registry"
      },
      {
        "name": "open_fmea_dataflow_pipeline.json",
        "role": "machine-readable flow/pipeline contract"
      },
      {
        "name": "open_fmea_dataflow_pipeline.md",
        "role": "human-readable architecture and validation workflow"
      },
      {
        "name": "open_fmea.sqlite",
        "role": "relational desktop/backend companion"
      },
      {
        "name": "open_fmea.sql",
        "role": "schema/export/migration representation"
      }
    ]
  },
  "validationPolicy": {
    "releaseGate": "No page is accepted until its mockup parity, functional and responsive validation tests pass.",
    "onFailure": [
      "create validation finding",
      "create/attach software failure mode",
      "run change impact",
      "implement corrective change",
      "rerun affected + regression tests",
      "store approved learning case"
    ],
    "mockupBaselineIsControlled": true
  },
  "functions": [],
  "designElements": [],
  "interfaces": [],
  "parameterDiagrams": [],
  "validationFindings": [
    {
      "id": "FIND-V18-001",
      "title": "DFMEA and shared runtime stabilization",
      "status": "In validation",
      "failureMode": "Incorrect counters, PFMEA rendering failure, inconsistent legacy ratings and incomplete analysis learning",
      "affectedPages": [
        "DFMEA",
        "PFMEA",
        "Learning",
        "Ishikawa",
        "WHY",
        "8D",
        "Poka-Yoke"
      ],
      "validationTest": "VAL-GUI-DFMEA-001",
      "sourceVersion": "1.8.1-dfmea"
    }
  ]
}
