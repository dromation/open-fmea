    {
      "id": "CASE-HIST-004",
      "title": "Visualization not connected to decision drill-down",
      "domain": "Open FMEA Software / GUI",
      "failureMode": "Risk matrix or chart exists visually but does not expose the underlying records or correct time interpretation.",
      "cause": "Visualization built as dashboard element rather than query over source-of-truth objects.",
      "detection": "User review and subsequent risk/timeline requirements.",
      "methods": [
        "Validation Test",
        "Change Impact",
        "Regression Analysis"
      ],
      "action": "All visual widgets must be reversible to their source record set and explicit time basis.",
      "result": "Requires/feeds regression validation",
      "lessons": [
        "Mockup is a controlled validation baseline.",
        "GUI regression is a software failure mode.",
        "Do not accept feature work without regression validation."
