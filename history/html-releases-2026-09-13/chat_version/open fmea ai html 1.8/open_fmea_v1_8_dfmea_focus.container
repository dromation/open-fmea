    },
    {
      "id": "CASE-HIST-003",
      "title": "GUI regression after adding new functionality",
      "domain": "Open FMEA Software / GUI",
      "failureMode": "A later build introduces features but moves away from supplied mockup layout or breaks previously accepted GUI behavior.",
      "cause": "No immutable per-page mockup baseline and no mandatory regression gate before release.",
      "detection": "Current user review of later Open FMEA builds.",
      "methods": [
        "Validation Test",
        "Change Impact",
        "Regression Analysis"
      ],
      "action": "Treat every mockup as a validation baseline; every GUI change requires mockup parity + functional + responsive regression.",
      "result": "Requires/feeds regression validation",
      "lessons": [
        "Mockup is a controlled validation baseline.",
        "GUI regression is a software failure mode.",
        "Do not accept feature work without regression validation."
      ],
