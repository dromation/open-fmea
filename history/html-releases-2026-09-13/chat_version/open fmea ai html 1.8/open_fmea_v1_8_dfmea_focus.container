  "rootCauseAnalyses": [
    {
      "id": "RCA-2025-009",
      "title": "Water ingress / seal failure investigation",
      "method": "Ishikawa + 5 Why",
      "linkedFailure": "FM-002",
      "status": "In Progress",
      "owner": "Marko Kovac",
      "problem": "Water ingress detected during environmental testing.",
      "categories": {
        "Man": [
          "Seal installation technique varies by operator"
        ],
        "Machine": [
          "Fixture does not positively locate seal"
        ],
        "Method": [
          "No explicit visual confirmation before release"
        ],
        "Material": [
          "Seal compression variation between lots"
        ],
        "Measurement": [
          "No in-line compression-height check"
        ],
        "Environment": [
          "Temperature cycling increases dimensional variation"
        ]
      },
      "whyChain": [
        "Why did water enter the housing? — Seal did not provide full contact.",
        "Why was full contact missing? — Seal was locally under-compressed.",
        "Why was compression insufficient? — Assembly position varied.",
        "Why could position vary? — Fixture permits positional tolerance.",
        "Why was this not detected? — No poka-yoke / in-line verification existed."
      ]
    },
    {
      "id": "RCA-2025-011",
      "title": "Incorrect weld / reduced joint strength",
      "method": "3 Why",
      "linkedFailure": "PF-004",
      "status": "Open",
      "owner": "Luka Sterle",
      "problem": "Weld strength below requirement.",
      "whyChain": [
        "Why was weld strength low? — Heat input was below target.",
        "Why was heat input below target? — Parameter set was incorrect.",
        "Why was the wrong set used? — Recipe selection was not interlocked to product variant."
      ]
    }
  ],
